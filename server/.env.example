# Copy to server/.env and edit.
# The game runs fine with no LLAMA_URL (a rule-based scorer is used instead).

PORT=3001
DATABASE_PATH=data/kingdoms.sqlite

# --- llama.cpp server -------------------------------------------------
# llama-server -hf ggml-org/gemma-3-4b-it-GGUF --port 8080
LLAMA_URL=http://127.0.0.1:8080
LLAMA_MODEL=local
LLAMA_TIMEOUT_MS=30000

# --- world pacing -----------------------------------------------------
AI_SCAN_INTERVAL_MS=300000
AI_SCAN_MESSAGES=50
TRADE_EXPIRY_MS=86400000
CHAT_RATE_LIMIT_MS=2000

# --- caravans ---------------------------------------------------------
# How long a wagon is on the road, and how many a faction may have out at once.
CARAVAN_TRAVEL_MS=45000
CARAVAN_MAX_IN_FLIGHT=2
